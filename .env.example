# Copiar a .env y ajustar
PORT=8080
JWT_SECRET=cambiar-esto-en-produccion
JWT_EXPIRA_SEGUNDOS=28800
DB_PATH=data/mensajeria.sqlite

# Mail: si SMTP_HOST está vacío, los mails se escriben en el log (modo desarrollo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mensajería de Barrio <no-reply@mensajeria.example.com>

# Carga de datos de ejemplo al iniciar si la base está vacía
SEED_DEMO=true
